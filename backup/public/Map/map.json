{
    "version": 8,
    "name": "Google Maps Style",
    "sources": {
      "openmaptiles": {
        "type": "vector",
        "url": "https://tiles.openfreemap.org/planet"
      }
    },
    "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
    "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
    "layers": [
      {
        "id": "bg",
        "type": "background",
        "paint": {
          "background-color": "#e5e3df"
        }
      },
      {
        "id": "landuse-residential",
        "type": "fill",
        "source": "openmaptiles",
        "source-layer": "landuse",
        "filter": [
          "==",
          "class",
          "residential"
        ],
        "paint": {
          "fill-color": "#ebe7e2"
        }
      },
      {
        "id": "landuse-park",
        "type": "fill",
        "source": "openmaptiles",
        "source-layer": "landuse",
        "filter": [
          "in",
          "class",
          "park",
          "nature_reserve",
          "wood",
          "grass",
          "forest"
        ],
        "paint": {
          "fill-color": "#c3e6b4",
          "fill-opacity": 1
        }
      },
      {
        "id": "landuse-recreation",
        "type": "fill",
        "source": "openmaptiles",
        "source-layer": "landuse",
        "filter": [
          "in",
          "class",
          "recreation_ground",
          "playground"
        ],
        "paint": {
          "fill-color": "#c3e6b4",
          "fill-opacity": 1
        }
      },
      {
        "id": "park-outline",
        "type": "line",
        "source": "openmaptiles",
        "source-layer": "landuse",
        "filter": [
          "in",
          "class",
          "park",
          "nature_reserve",
          "wood",
          "grass",
          "forest"
        ],
        "paint": {
          "line-color": "#9dd687",
          "line-width": 0.5,
          "line-opacity": 0.6
        }
      },
      {
        "id": "water",
        "type": "fill",
        "source": "openmaptiles",
        "source-layer": "water",
        "paint": {
          "fill-color": "#a5d5e6"
        }
      },
      {
        "id": "waterway",
        "type": "line",
        "source": "openmaptiles",
        "source-layer": "waterway",
        "paint": {
          "line-color": "#a5d5e6",
          "line-width": [
            "interpolate",
            [
              "linear"
            ],
            [
              "zoom"
            ],
            8,
            0.5,
            20,
            6
          ]
        }
      },
      {
        "id": "roads-casing",
        "type": "line",
        "source": "openmaptiles",
        "source-layer": "transportation",
        "filter": [
          "in",
          "class",
          "motorway",
          "trunk",
          "primary",
          "secondary"
        ],
        "layout": {
          "line-cap": "round",
          "line-join": "round"
        },
        "paint": {
          "line-color": "#e0ddd8",
          "line-width": [
            "interpolate",
            [
              "linear"
            ],
            [
              "zoom"
            ],
            10,
            2,
            14,
            8,
            18,
            20
          ]
        }
      },
      {
        "id": "roads-motorway",
        "type": "line",
        "source": "openmaptiles",
        "source-layer": "transportation",
        "filter": [
          "==",
          "class",
          "motorway"
        ],
        "layout": {
          "line-cap": "round",
          "line-join": "round"
        },
        "paint": {
          "line-color": "#fda85d",
          "line-width": [
            "interpolate",
            [
              "linear"
            ],
            [
              "zoom"
            ],
            10,
            1.5,
            14,
            6,
            18,
            16
          ]
        }
      },
      {
        "id": "roads-trunk-primary",
        "type": "line",
        "source": "openmaptiles",
        "source-layer": "transportation",
        "filter": [
          "in",
          "class",
          "trunk",
          "primary"
        ],
        "layout": {
          "line-cap": "round",
          "line-join": "round"
        },
        "paint": {
          "line-color": "#fec859",
          "line-width": [
            "interpolate",
            [
              "linear"
            ],
            [
              "zoom"
            ],
            10,
            1.5,
            14,
            5,
            18,
            14
          ]
        }
      },
      {
        "id": "roads-secondary",
        "type": "line",
        "source": "openmaptiles",
        "source-layer": "transportation",
        "filter": [
          "==",
          "class",
          "secondary"
        ],
        "layout": {
          "line-cap": "round",
          "line-join": "round"
        },
        "paint": {
          "line-color": "#ffffff",
          "line-width": [
            "interpolate",
            [
              "linear"
            ],
            [
              "zoom"
            ],
            10,
            1,
            14,
            4,
            18,
            12
          ]
        }
      },
      {
        "id": "roads-minor",
        "type": "line",
        "source": "openmaptiles",
        "source-layer": "transportation",
        "filter": [
          "in",
          "class",
          "minor",
          "service",
          "track"
        ],
        "layout": {
          "line-cap": "round",
          "line-join": "round"
        },
        "paint": {
          "line-color": "#ffffff",
          "line-width": [
            "interpolate",
            [
              "linear"
            ],
            [
              "zoom"
            ],
            12,
            0.5,
            14,
            2,
            18,
            8
          ]
        }
      },
      {
        "id": "buildings",
        "type": "fill",
        "source": "openmaptiles",
        "source-layer": "building",
        "minzoom": 13,
        "paint": {
          "fill-color": "#e0ddd8",
          "fill-outline-color": "#d6d2cc"
        }
      },
      {
        "id": "buildings-3d",
        "type": "fill-extrusion",
        "source": "openmaptiles",
        "source-layer": "building",
        "minzoom": 15,
        "paint": {
          "fill-extrusion-color": "#e0ddd8",
          "fill-extrusion-height": [
            "interpolate",
            [
              "linear"
            ],
            [
              "zoom"
            ],
            15,
            0,
            16,
            [
              "get",
              "render_height"
            ]
          ],
          "fill-extrusion-base": [
            "get",
            "render_min_height"
          ],
          "fill-extrusion-opacity": 0.8
        }
      },
      {
        "id": "place-labels-city",
        "type": "symbol",
        "source": "openmaptiles",
        "source-layer": "place",
        "filter": [
          "==",
          "class",
          "city"
        ],
        "minzoom": 8,
        "layout": {
          "text-field": [
            "get",
            "name"
          ],
          "text-font": [
            "Noto Sans Bold"
          ],
          "text-size": [
            "interpolate",
            [
              "linear"
            ],
            [
              "zoom"
            ],
            8,
            12,
            12,
            18
          ]
        },
        "paint": {
          "text-color": "#2d2d2d",
          "text-halo-color": "#ffffff",
          "text-halo-width": 2
        }
      },
      {
        "id": "place-labels-town",
        "type": "symbol",
        "source": "openmaptiles",
        "source-layer": "place",
        "filter": [
          "in",
          "class",
          "town",
          "village"
        ],
        "minzoom": 10,
        "layout": {
          "text-field": [
            "get",
            "name"
          ],
          "text-font": [
            "Noto Sans Regular"
          ],
          "text-size": [
            "interpolate",
            [
              "linear"
            ],
            [
              "zoom"
            ],
            10,
            10,
            14,
            14
          ]
        },
        "paint": {
          "text-color": "#4d4d4d",
          "text-halo-color": "#ffffff",
          "text-halo-width": 1.5
        }
      },
      {
        "id": "place-labels-suburb",
        "type": "symbol",
        "source": "openmaptiles",
        "source-layer": "place",
        "filter": [
          "in",
          "class",
          "suburb",
          "neighbourhood"
        ],
        "minzoom": 12,
        "layout": {
          "text-field": [
            "get",
            "name"
          ],
          "text-font": [
            "Noto Sans Regular"
          ],
          "text-size": 11,
          "text-transform": "uppercase",
          "text-letter-spacing": 0.1
        },
        "paint": {
          "text-color": "#888888",
          "text-halo-color": "#ffffff",
          "text-halo-width": 1.5
        }
      },
      {
        "id": "road-labels-motorway",
        "type": "symbol",
        "source": "openmaptiles",
        "source-layer": "transportation_name",
        "filter": [
          "==",
          "class",
          "motorway"
        ],
        "minzoom": 11,
        "layout": {
          "text-field": [
            "get",
            "name"
          ],
          "text-font": [
            "Noto Sans Bold"
          ],
          "text-size": 11,
          "symbol-placement": "line",
          "text-rotation-alignment": "map",
          "text-pitch-alignment": "viewport"
        },
        "paint": {
          "text-color": "#4a85bb",
          "text-halo-color": "#ffffff",
          "text-halo-width": 2
        }
      },
      {
        "id": "road-labels-major",
        "type": "symbol",
        "source": "openmaptiles",
        "source-layer": "transportation_name",
        "filter": [
          "in",
          "class",
          "trunk",
          "primary",
          "secondary"
        ],
        "minzoom": 12,
        "layout": {
          "text-field": [
            "get",
            "name"
          ],
          "text-font": [
            "Noto Sans Regular"
          ],
          "text-size": 11,
          "symbol-placement": "line",
          "text-rotation-alignment": "map",
          "text-pitch-alignment": "viewport"
        },
        "paint": {
          "text-color": "#4a85bb",
          "text-halo-color": "#ffffff",
          "text-halo-width": 2
        }
      },
      {
        "id": "road-labels-minor",
        "type": "symbol",
        "source": "openmaptiles",
        "source-layer": "transportation_name",
        "filter": [
          "in",
          "class",
          "minor",
          "service"
        ],
        "minzoom": 14,
        "layout": {
          "text-field": [
            "get",
            "name"
          ],
          "text-font": [
            "Noto Sans Regular"
          ],
          "text-size": 10,
          "symbol-placement": "line",
          "text-rotation-alignment": "map",
          "text-pitch-alignment": "viewport"
        },
        "paint": {
          "text-color": "#666666",
          "text-halo-color": "#ffffff",
          "text-halo-width": 2
        }
      }
    ]
  }