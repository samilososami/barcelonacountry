{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build && mv dist/index.html dist/app.html",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/privacidad", "destination": "/#/privacidad", "permanent": false },
    { "source": "/aviso-legal", "destination": "/#/aviso-legal", "permanent": false },
    { "source": "/cookies", "destination": "/#/cookies", "permanent": false },
    { "source": "/blog", "destination": "/#/blog", "permanent": false },
    { "source": "/newsletters", "destination": "/#/blog", "permanent": false },
    { "source": "/newsletters/:slug", "destination": "/#/blog/:slug", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/login", "destination": "/app.html" },
    { "source": "/dashboard", "destination": "/app.html" },
    { "source": "/dashbord", "destination": "/app.html" },
    { "source": "/admin/newsletters", "destination": "/app.html" },
    { "source": "/baja", "destination": "/app.html" },
    { "source": "/entradas", "destination": "/app.html" },
    { "source": "/tickets", "destination": "/app.html" },
    { "source": "/buy", "destination": "/app.html" },
    { "source": "/bcn", "destination": "/app.html" },
    { "source": "/bcn/", "destination": "/app.html" },
    { "source": "/bcn/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/bcn/fonts/:path*", "destination": "/fonts/:path*" },
    { "source": "/bcn/:path*", "destination": "/app.html" },
    { "source": "/(.*)", "destination": "https://barcelonacountry-new.vercel.app/$1" }
  ]
}
